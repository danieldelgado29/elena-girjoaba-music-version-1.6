rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Estado general usado por panel y cliente.
    match /config/estado {
      allow read, write: if true;
    }

    // Una edición ligera por canción y por cancionero.
    // Ejemplos: imageEdits/elena-c002, imageEdits/daniel-c002
    match /imageEdits/{editId} {
      allow read, write: if true;
    }
  }
}
